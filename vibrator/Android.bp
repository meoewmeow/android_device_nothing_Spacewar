cc_binary {
    name: "android.hardware.vibrator.service.spacewar",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"android.hardware.vibrator.service.spacewar\"",
    ],
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator.service.spacewar.rc"],
    vintf_fragments: [
        "android.hardware.vibrator.service.spacewar.xml",
    ],
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
        "libbase",
        "libbinder_ndk",
        "libaacvibrator",
        "android.hardware.vibrator-V2-ndk",
    ],
    target: {
        // The Spacewar Richtap library is arm64-only. Cuttlefish supplies its
        // own generic vibrator implementation on x86_64.
        android_x86_64: {
            enabled: false,
        },
    },
}
